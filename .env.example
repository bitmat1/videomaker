# Copy to .env (gitignored) or export in your shell. All optional.

# Stock media. Both free: https://www.pexels.com/api/ and https://pixabay.com/api/docs/
# Without them, Openverse and Wikimedia Commons are still searched (no key needed).
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice: kokoro | piper | say | mock
VM_TTS_BACKEND=kokoro
# For piper: path to a downloaded .onnx voice
PIPER_MODEL=

# Planner for unattended runs: agent | ollama | mock
VM_PLAN_BACKEND=agent
OLLAMA_MODEL=llama3.1:8b

# ElevenLabs MCP server (optional, paid, cloud)
ELEVENLABS_API_KEY=

# Use an installed Chromium instead of Remotion's downloaded shell
REMOTION_BROWSER=
